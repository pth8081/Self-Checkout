{
  "name": "brg-self-checkout",
  "version": "0.1.0",
  "private": true,
  "description": "BRG Self Checkout: PWA khách tự quét, thu ngân, kiểm soát cổng và quản trị",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node scripts/build-sw.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js --reset",
    "vendor": "node scripts/vendor.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "create-admin": "node server/create-admin.js",
    "seed:demo": "node server/seed.js --reset --demo",
    "e2e": "bash e2e/run.sh",
    "build:sw": "node scripts/build-sw.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
