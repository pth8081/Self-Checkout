{
  "name": "brg-self-checkout",
  "version": "1.7.0",
  "private": true,
  "description": "BRG Scan & Checkout: PWA khách tự quét, thu ngân, kiểm soát cổng và quản trị",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "prestart": "node scripts/build-sw.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js --reset",
    "vendor": "node scripts/vendor.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "create-admin": "node server/create-admin.js",
    "import-products": "node scripts/import-products.js",
    "seed:demo": "node server/seed.js --reset --demo",
    "e2e": "bash e2e/run.sh",
    "build:sw": "node scripts/build-sw.js",
    "start:prod": "node --env-file=.env server/index.js",
    "backup": "node scripts/backup.js",
    "loadtest": "node scripts/loadtest.js",
    "version:bump": "node scripts/bump-version.js",
    "mssql:init": "node --env-file=.env scripts/mssql-init.js",
    "test:mssql": "TEST_DB=mssql node --test --test-timeout=180000 test/*.test.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@zxing/library": "^0.21.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "htm": "^3.1.1",
    "mssql": "^12.7.14",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "preact": "^10.29.8",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
