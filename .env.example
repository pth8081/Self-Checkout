# Sao chép thành .env rồi điền giá trị thật. KHÔNG đưa .env vào git. Không viết chú thích cùng dòng với giá trị.
NODE_ENV=production
PORT=3000
# Chỉ nhận kết nối từ Nginx trên cùng máy
HOST=127.0.0.1
# 1 khi chạy sau Nginx (ghi đúng địa chỉ IP khách trong nhật ký)
TRUST_PROXY=1
# Địa chỉ công khai của hệ thống, dùng làm link xem bill trong email (không có dấu / ở cuối)
PUBLIC_URL=https://scan.hcrc.vn
# Chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -hex 32. Đổi khóa thì mọi QR chưa dùng mất hiệu lực.
APP_SECRET=
# Quản trị bắt buộc xác thực 2 bước khi đăng nhập (mặc định bật). Đặt 0 chỉ để thử nghiệm
# REQUIRE_ADMIN_2FA=1
# Mã hình 4 số khi đăng nhập quản trị (mặc định bật). Hai mục này đổi được ở trang Tài khoản & phân quyền
# REQUIRE_CAPTCHA=1
# Mỗi tài khoản quản trị chỉ đăng nhập một thiết bị (mặc định bật). Phiên nhàn rỗi quá số phút này thì đăng nhập mới không bị hỏi
# SINGLE_SESSION=1
# ADMIN_SESSION_IDLE_MIN=120
# Đăng nhập bằng vân tay / khuôn mặt cần PUBLIC_URL đúng địa chỉ https đang dùng (ví dụ https://scan.hcrc.vn)
# Cơ sở dữ liệu: sqlite (mặc định, một file) hoặc mssql (SQL Server)
DB_DRIVER=sqlite
DB_FILE=/var/lib/brg/brg.db
# --- Chỉ dùng khi DB_DRIVER=mssql (tạo CSDL/tài khoản: xem hướng dẫn triển khai, rồi chạy npm run mssql:init) ---
# MSSQL_SERVER=10.0.0.5
# MSSQL_PORT=1433
# MSSQL_DATABASE=brg
# MSSQL_USER=brg_app
# MSSQL_PASSWORD=
# MSSQL_ENCRYPT=1          # 0 để tắt mã hóa kết nối
# MSSQL_TRUST_CERT=0       # 1 khi SQL Server dùng chứng chỉ tự ký
# MSSQL_REQUEST_TIMEOUT=30
# Thời hạn QR biên nhận (phút) và chu kỳ đồng bộ POS (giây)
RECEIPT_TTL_MIN=180
POS_SYNC_SECONDS=60
LOG_LEVEL=info
# Sao lưu: thư mục và số bản giữ lại
BACKUP_DIR=/var/backups/brg
BACKUP_KEEP=14
# Giỏ bị bỏ quên quá số giờ này thì được dọn tự động
CART_TTL_HOURS=3
# Giỏ đã bấm Thanh toán mà quá số phút này chưa thanh toán thì hủy đơn (mã QR hết hạn, giỏ hàng vẫn giữ để tạo mã mới)
LOCKED_TTL_MINUTES=30
# Số mặt hàng khác nhau tối đa trong một giỏ (mã QR chứa cả giỏ nên không nên quá lớn)
MAX_CART_ITEMS=200
